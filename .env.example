# account-management — copy to .env and fill in real values. The .env file is gitignored.
# Consumed by docker-compose (env_file). For local `gradle bootRun`, application.properties
# already defaults non-secret values to localhost; export SPRING_DATASOURCE_PASSWORD and
# JWT_SECRET in your shell/IDE for local runs.

# Database (Docker hostnames shown; for local use jdbc:mysql://localhost:3306/...)
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/account_management?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me

# Shared JWT secret — MUST be identical across all services
JWT_SECRET=change-me-to-a-long-random-secret

# Inter-service (Feign) base URLs — Docker service names
AUTH_SERVICE_BASE_URL=http://auth-service:8080/
